{
  "name": "dronesmasher",
  "version": "0.1.0",
  "description": "Physics-based drone frame topology optimization with WebGPU",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate-shaders && tsc && vite build",
    "preview": "vite preview",
    "prebuild": "tsx scripts/generate-shader-constants.ts",
    "validate-shaders": "tsx scripts/validate-shaders.ts",
    "predev": "npm run validate-shaders",
    "test": "vitest",
    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "tsx": "^4.7.0",
    "@webgpu/types": "^0.1.40"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
